# Copia este archivo como .env.local y completa los valores de tu proyecto Supabase.
# Estos valores son publicos por diseno (la anon key esta pensada para el navegador).
# La seguridad real vive en las politicas RLS de la base de datos, no en ocultar estas claves.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY_PUBLICA
